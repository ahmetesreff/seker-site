{
  // Yalnızca statik dosya sunan Worker (kod yok). site/ olduğu gibi yayınlanır.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "seker-site",
  "compatibility_date": "2026-11-01",
  // Alan adları burada değil, panelde/API'de Custom Domain: sekermermer.com.tr ve www.sekermermer.com.tr
  // (2026-11-08'den beri ikisi de bu Worker'da, sunucuya bağ yok). www → apex yönlendirmesini Worker'dan
  // önce çalışan Redirect Rule yapar. routes eklenmedikçe yayınlar bu bağlantılara dokunmaz.
  // workers.dev ve sürüm önizleme adresleri kapalı: sitenin ikinci kopyası olmasın (SEO) ve
  // her yayında yeniden açılmasın (panelden kapatmak yetmez, burada false olmalı).
  "workers_dev": false,
  "preview_urls": false,
  "assets": {
    "directory": "./site",
    // bilinmeyen adreslerde site/404.html, 404 durum koduyla
    "not_found_handling": "404-page"
  }
}
